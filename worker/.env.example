# Copy to .env for LOCAL development only.
# On Railway, set these in the service's Variables tab instead — do not commit a .env.

# Where the worker POSTs extracted tasks (your published ParentPulse app)
INGEST_URL=https://parentpulse-task-digest.lovable.app/api/public/ingest-task

# AI task classifier (understands polite Hebrew requests). Optional override.
CLASSIFY_URL=https://parentpulse-task-digest.lovable.app/api/public/classify-task

# Shared secret — must match WORKER_SECRET stored in Lovable Cloud
WORKER_SECRET=

# The parent's user id that ingested tasks belong to (UUID)
USER_ID=

# Groq API key for Hebrew voice-note transcription (whisper-large-v3-turbo)
GROQ_API_KEY=

# Baileys auth state directory. On Railway attach a Volume and mount it at /data,
# then set AUTH_DIR=/data/auth_session so the pairing survives redeploys.
AUTH_DIR=./auth_session

# Comma-separated group names to listen to (empty = all groups)
TRACKED_GROUPS=

# Notification delivery is triggered through the published app. VAPID keys
# remain in Lovable Cloud and are intentionally not copied into Railway.
NOTIFY_URL=https://parentpulse-task-digest.lovable.app/api/public/notify-jobs
