{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["node"],
      "phases": {
        "setup": { "nixPkgs": ["nodejs_20"] },
        "install": { "cmds": ["npm install --omit=dev"] }
      }
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
